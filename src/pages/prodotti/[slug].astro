---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { productCategories } from '../../data/catalog';
import { categoryCardImages } from '../../data/card-images';
import { categoryPageImages } from '../../data/category-page-images';
import { site } from '../../data/site';
import { ArrowRight, MapPin, Phone } from '@lucide/astro';

export function getStaticPaths() {
  return productCategories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const pageImages = categoryPageImages[category.slug];
const relatedCategories = productCategories.filter((item) => item.slug !== category.slug).slice(0, 4);
const visualPools = {
  'arredo-complementi': [
    '/images/arredamento/product/sedute-operative.svg',
    '/images/arredamento/product/lampade-organizer.svg',
    '/images/arredamento/brand/postazioni-lavoro.svg',
    '/images/arredamento/brand/ergonomia.svg',
  ],
  'carta-modulistica': [
    '/images/cancelleria/carta-buffetti-gialla.png',
    '/images/cancelleria/carta-buffetti-rosa.png',
    '/images/cancelleria/brand/archiviazione.webp',
    '/images/scuola/product/quaderni-diari.svg',
  ],
  'cartucce-toner': [
    '/images/ufficio/product/toner-cartucce.svg',
    '/images/ufficio/brand/macchine-ufficio.svg',
  ],
  archiviazione: [
    '/images/ufficio/product/archivio-ufficio.svg',
    '/images/cancelleria/brand/archiviazione.webp',
  ],
  cancelleria: [
    '/images/cancelleria/brand/scrittura.webp',
    '/images/cancelleria/carta-buffetti-gialla.png',
    '/images/scuola/brand/quaderni.svg',
    '/images/ufficio/brand/accessori-scrivania.svg',
  ],
  'disegno-didattica': [
    '/images/scuola/brand/colori.svg',
    '/images/scuola/brand/disegno-tecnico.svg',
    '/images/scuola/product/zaini-astucci.svg',
    '/images/scuola/product/quaderni-diari.svg',
  ],
  'visual-comunicazione': [
    '/images/ufficio/brand/accessori-scrivania.svg',
    '/images/arredamento/brand/postazioni-lavoro.svg',
  ],
  'comunita-servizi': [
    '/images/servizi/product/stampa-spedizioni.svg',
    '/images/servizi/brand/fotocopie.svg',
  ],
  'spedizione-imballaggi': [
    '/images/servizi/brand/spedizioni.svg',
    '/images/servizi/product/stampa-spedizioni.svg',
  ],
  'informatica-elettronica': [
    '/images/ufficio/brand/macchine-ufficio.svg',
    '/images/ufficio/product/toner-cartucce.svg',
  ],
  'macchine-ufficio': [
    '/images/ufficio/brand/macchine-ufficio.svg',
    '/images/servizi/product/stampa-spedizioni.svg',
  ],
  ecosostenibili: [
    '/images/cancelleria/brand/archiviazione.webp',
    '/images/cancelleria/carta-buffetti-gialla.png',
  ],
};
const imagePool = visualPools[category.slug] ?? [category.image];
const itemCards = category.items.map((item, index) => ({
  title: item,
  image: pageImages?.items?.[item] ?? imagePool[index % imagePool.length],
}));
const title = `${category.label} a Cesena | Catalogo Buffetti`;
const description = `${category.label} Buffetti a Cesena: ${category.summary}`;
---

<BaseLayout title={title} description={description} preloadImage={pageImages?.heroBackground}>
  <section
    class:list={['category-hero', pageImages?.heroBackground && 'category-hero--has-background']}
    style={`--category-accent: ${category.accent ?? '#0000e8'}`}
  >
    {pageImages?.heroBackground ? (
      <div class="category-hero__background" aria-hidden="true">
        <img src={pageImages.heroBackground} alt="" loading="eager" fetchpriority="high" decoding="async" />
      </div>
    ) : null}
    <div class="category-hero__pattern" aria-hidden="true">
      <svg viewBox="0 0 640 420" role="img">
        <path d="M88 80h120v74H88z" />
        <path d="M246 74h76v166h-76z" />
        <path d="M372 94h156v96H372z" />
        <path d="M104 238h170v82H104z" />
        <path d="M344 254h122v90H344z" />
        <circle cx="540" cy="292" r="46" />
        <path d="M118 126h70M262 116h42M390 138h102M126 278h104M366 298h76" />
      </svg>
    </div>

    <div class="container category-hero__inner">
      <div class="category-hero__copy">
        <span class="eyebrow">Catalogo prodotti</span>
        <h1>{category.label}</h1>
        <p>{category.summary}</p>

        <div class="category-hero__actions">
          <a class="btn btn--primary" href={site.phoneHref}>
            <Phone size={18} stroke-width={2.2} class="cta-icon" />
            Chiedi disponibilità
          </a>
          <a class="btn btn--ghost" href="/contatti.html">
            <MapPin size={18} stroke-width={2.2} class="cta-icon" />
            Passa in negozio
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container category-detail">
      <div class="section-head">
        <span class="eyebrow">Cosa puoi cercare</span>
        <h2>Prodotti collegati</h2>
        <p>
          Questa pagina raccoglie la famiglia prodotto in modo piu specifico: puoi usarla
          come promemoria prima di chiamare o passare in negozio.
        </p>
      </div>

      <div class:list={['item-grid', pageImages?.itemDisplay === 'ambient' && 'item-grid--ambient']}>
        {itemCards.map((item) => (
          <article>
            <div
              class:list={[
                'item-card__media',
                (pageImages?.itemDisplay === 'ambient' || item.title === 'Scrivanie e accessori') && 'item-card__media--scene',
              ]}
              style={pageImages?.itemPositions?.[item.title] ? `--item-position: ${pageImages.itemPositions[item.title]}` : undefined}
            >
              <img
                src={item.image}
                alt={item.title}
                loading="lazy"
              />
            </div>
            <div class="item-card__body">
              <strong>{item.title}</strong>
            </div>
          </article>
        ))}
      </div>

      <aside class="catalog-invite" aria-labelledby="catalog-invite-title">
        <div>
          <span class="eyebrow">E c'è molto altro</span>
          <h3 id="catalog-invite-title">Il catalogo continua in negozio.</h3>
          <p>
            Vieni a trovarc e ti aiuteremo a confrontare soluzioni, misure e disponibilità
            per scegliere ciò che ti serve davvero
          </p>
        </div>
        <a class="btn btn--primary" href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
          <MapPin size={19} stroke-width={2.3} />
          Vieni a trovarci
        </a>
      </aside>
    </div>
  </section>

  <section class="section social-cta">
    <div class="container social-cta__inner">
      <div>
        <span class="eyebrow">Negozio reale, risposta reale</span>
        <h2>Vuoi sapere se c'e in negozio?</h2>
        <p>
          Chiama, scrivi o guarda i canali social: per prodotti specifici e disponibilita
          conviene sempre parlare direttamente con Buffetti Cucchi.
        </p>
      </div>

      <div class="social-actions">
        <a href={site.phoneHref}>
          <Phone size={20} stroke-width={2.3} />
          <span>Chiama</span>
        </a>
        <a href={site.facebook} target="_blank" rel="noopener noreferrer">
          <img src="/images/facebook.svg" alt="" loading="lazy" />
          <span>Facebook</span>
        </a>
        <a href={site.instagram} target="_blank" rel="noopener noreferrer">
          <img src="/images/instagram.svg" alt="" loading="lazy" />
          <span>Instagram</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section related-section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Altre famiglie</span>
        <h2>Continua nel catalogo</h2>
      </div>

      <div class="related-grid">
        {relatedCategories.map((item) => (
          <a href={item.href}>
            <img src={categoryCardImages[item.slug] ?? item.image} alt={item.label} loading="lazy" />
            <strong>{item.label}</strong>
            <span>{item.summary}</span>
            <ArrowRight size={18} stroke-width={2.2} />
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow {
    display: inline-flex;
    margin-bottom: 16px;
    color: var(--category-accent, #0000e8);
    font-size: 0.76rem;
    font-weight: 840;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .category-hero {
    position: relative;
    overflow: hidden;
    padding: 96px 0 82px;
    background:
      radial-gradient(circle at 82% 32%, color-mix(in srgb, var(--category-accent, #0000e8) 18%, transparent), transparent 28%),
      linear-gradient(135deg, rgba(0, 0, 232, 0.08), rgba(0, 166, 232, 0.08)),
      #fff;
  }

  .category-hero__background {
    position: absolute;
    inset: 0;
  }

  .category-hero__background::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 18, 48, 0.92) 0%, rgba(0, 31, 69, 0.78) 48%, rgba(0, 31, 69, 0.45) 100%);
  }

  .category-hero__background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 52%;
  }

  .category-hero--has-background .category-hero__pattern {
    display: none;
  }

  .category-hero.category-hero--has-background h1,
  .category-hero.category-hero--has-background .eyebrow {
    color: #fff;
  }

  .category-hero.category-hero--has-background p {
    color: rgba(255, 255, 255, 0.84);
  }

  .category-hero__pattern {
    position: absolute;
    inset: auto 0 0 auto;
    width: min(48vw, 620px);
    opacity: 0.12;
    color: var(--category-accent, #0000e8);
    pointer-events: none;
  }

  .category-hero__pattern svg {
    width: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 10;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .category-hero__inner {
    position: relative;
    z-index: 1;
  }

  .category-hero__copy {
    max-width: 780px;
  }

  .category-hero h1,
  .section-head h2,
  .social-cta h2 {
    margin: 0;
    color: var(--color-primary-dark);
    font-size: clamp(2.5rem, 5.2vw, 5rem);
    line-height: 0.94;
    letter-spacing: -0.052em;
  }

  .category-hero p,
  .section-head p,
  .social-cta p {
    max-width: 660px;
    margin: 22px 0 0;
    color: var(--color-muted);
    font-size: 1.06rem;
    line-height: 1.78;
  }

  .category-hero__actions {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .section-head {
    max-width: 760px;
    margin-bottom: 34px;
  }

  .section-head h2,
  .social-cta h2 {
    font-size: clamp(2rem, 4vw, 3.5rem);
  }

  .item-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: max-content;
    align-items: start;
    gap: 18px;
  }

  .item-grid article {
    min-height: 0;
    align-self: start;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto auto;
    border: 1px solid rgba(204, 221, 237, 0.84);
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0.92)),
      radial-gradient(circle at 88% 10%, color-mix(in srgb, var(--category-accent, #0000e8) 11%, transparent), transparent 36%);
    box-shadow: 0 18px 50px rgba(0, 31, 69, 0.075);
  }

  .item-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid rgba(204, 221, 237, 0.7);
    background: #f7f9fc;
    isolation: isolate;
  }

  .item-card__media img {
    position: absolute;
    inset: 14px 18px;
    display: block;
    width: calc(100% - 36px);
    height: calc(100% - 28px);
    object-fit: contain;
    object-position: center;
    filter: none;
  }

  .item-card__media:not(.item-card__media--scene) img {
    mix-blend-mode: multiply;
    filter: contrast(1.025) saturate(1.035);
  }

  .item-card__media--scene {
    padding: 0;
  }

  .item-card__media--scene img {
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
    object-position: var(--item-position, center);
    mix-blend-mode: normal;
    filter: none;
  }

  .item-grid--ambient .item-card__media {
    aspect-ratio: 16 / 9;
  }

  .item-card__body {
    padding: 18px 20px 20px;
  }

  .item-grid strong {
    display: block;
    color: var(--color-primary-dark);
    font-size: 1.12rem;
    line-height: 1.25;
  }

  .catalog-invite {
    margin-top: 34px;
    padding: 52px 32px;
    display: grid;
    justify-items: center;
    gap: 24px;
    text-align: center;
    border: 1px solid rgba(0, 166, 232, 0.22);
    border-radius: 14px;
    background: linear-gradient(120deg, rgba(0, 166, 232, 0.08), rgba(0, 0, 232, 0.045));
  }

  .catalog-invite .eyebrow {
    margin-bottom: 12px;
    font-size: 0.84rem;
  }

  .catalog-invite h3 {
    margin: 0;
    color: var(--color-primary-dark);
    font-size: clamp(2rem, 3.3vw, 3rem);
    line-height: 1.05;
  }

  .catalog-invite p {
    max-width: 660px;
    margin: 16px auto 0;
    color: var(--color-muted);
    font-size: 1.08rem;
    line-height: 1.6;
  }

  .catalog-invite .btn {
    flex: 0 0 auto;
    min-height: 48px;
    padding-inline: 24px;
  }

  .social-cta {
    color: #fff;
    background: #0000e8;
  }

  .social-cta .eyebrow,
  .social-cta h2 {
    color: #fff;
  }

  .social-cta p {
    color: rgba(255, 255, 255, 0.78);
  }

  .social-cta__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 36px;
    align-items: center;
  }

  .social-actions {
    display: grid;
    gap: 12px;
    min-width: 250px;
  }

  .social-actions a {
    min-height: 56px;
    padding: 0 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    color: #0000e8;
    background: #fff;
    border-radius: 4px;
    font-weight: 840;
    transition: transform 0.18s ease;
  }

  .social-actions img {
    width: 20px;
    height: 20px;
  }

  .social-actions a:hover {
    transform: translateY(-3px);
  }

  .related-section {
    background: #f5f8fc;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .related-grid a {
    min-height: 280px;
    padding: 20px;
    display: grid;
    align-content: start;
    gap: 12px;
    border: 1px solid #dfe8f2;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 16px 42px rgba(0, 31, 69, 0.07);
  }

  .related-grid img {
    width: 100%;
    height: 105px;
    object-fit: cover;
    border-radius: 4px;
    margin-bottom: 4px;
    filter: drop-shadow(0 14px 18px rgba(0, 31, 69, 0.1));
  }

  .related-grid strong {
    color: #0000e8;
    font-size: 1.05rem;
  }

  .related-grid span {
    color: var(--color-muted);
    line-height: 1.45;
  }

  .related-grid svg {
    margin-top: auto;
    color: #0000e8;
  }

  @media (max-width: 980px) {
    .category-hero__inner,
    .social-cta__inner {
      grid-template-columns: 1fr;
    }

    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .item-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .category-hero {
      padding: 58px 0 46px;
    }

    .category-hero h1 {
      font-size: clamp(2.2rem, 14vw, 3.35rem);
      line-height: 0.96;
    }

    .category-hero p,
    .section-head p,
    .social-cta p {
      font-size: 1rem;
      line-height: 1.65;
    }

    .item-grid,
    .related-grid {
      grid-template-columns: 1fr;
    }

    .item-grid article,
    .related-grid a {
      min-height: auto;
    }

    .catalog-invite {
      margin-top: 24px;
      padding: 38px 20px;
      gap: 22px;
    }

    .catalog-invite h3 {
      font-size: clamp(1.75rem, 9vw, 2.25rem);
    }

    .catalog-invite p {
      font-size: 1rem;
    }

    .catalog-invite .btn {
      width: 100%;
      justify-content: center;
    }

    .social-actions {
      min-width: 0;
    }
  }
</style>

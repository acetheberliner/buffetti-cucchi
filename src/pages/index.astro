---
import BaseLayout from '../layouts/BaseLayout.astro';
import { digitalServices, productCategories, shopFocusAreas } from '../data/catalog';
import { categoryCardImages as categoryImages, serviceCardImages as serviceImages } from '../data/card-images';
import { site } from '../data/site';
import { ArrowRight, ChevronDown, MapPin, Phone, Search } from '@lucide/astro';

const heroCategories = productCategories;
const serviceCards = digitalServices.slice(0, 4);

---

<BaseLayout
  title="Buffetti Cucchi Cesena | Cartoleria, ufficio, scuola e servizi digitali"
  description="Buffetti Cucchi a Cesena: prodotti Buffetti, cancelleria, articoli scuola, forniture per ufficio, PEC, firma digitale, fotocopie, spedizioni e servizi in negozio."
>
  <section class="home-hero">
    <div class="home-hero__media">
      <img src="/images/hero-home.png" alt="Esterno della cartoleria Buffetti Cucchi a Cesena" />
    </div>

    <div class="container home-hero__inner">
      <div class="home-hero__content">
        <span class="eyebrow">Buffetti Cucchi Cesena</span>
        <h1>Soluzioni che semplificano scuola, ufficio e pratiche.</h1>
        <p>
          Prodotti Buffetti, servizi digitali, stampa, spedizioni, scuola e ufficio:
          scegli online cosa ti serve e poi parlane con chi lo conosce davvero.
        </p>

        <div class="home-hero__actions">
          <a class="btn btn--primary" href={site.phoneHref}>
            <Phone size={18} stroke-width={2.2} class="cta-icon" />
            Chiama ora
          </a>
          <a class="btn btn--ghost" href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
            <MapPin size={18} stroke-width={2.2} class="cta-icon" />
            Vieni in negozio
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="anniversary-section" aria-labelledby="anniversary-title">
    <div class="container anniversary-card">
      <figure class="anniversary-portrait">
        <img
          src="/images/staff.jpeg"
          alt="Sandra Casadei, Elisabetta Cucchi ed Elena Cucchi nel negozio Buffetti Cucchi"
          loading="eager"
        />

        <div class="anniversary-seal" aria-hidden="true">
          <strong>30</strong>
          <span>anni insieme</span>
        </div>

        <figcaption>Due generazioni, la stessa cura per il negozio e per chi entra a farci visita ogni giorno!</figcaption>
      </figure>

      <div class="anniversary-copy">
        <span class="eyebrow">30° anniversario · Una storia di famiglia</span>
        <h2 id="anniversary-title">Da trent’anni a Cesena!</h2>
        <p class="anniversary-lead">
          Buffetti Cucchi è prima di tutto una storia familiare: esperienza, presenza quotidiana
          e un modo diretto di aiutare le persone a trovare ciò che serve davvero.
        </p>

        <div class="anniversary-family" aria-label="La famiglia Buffetti Cucchi">
          <div>
            <strong>Sandra Casadei in Cucchi</strong>
          </div>
          <div>
            <strong>Elisabetta Cucchi</strong>
          </div>
          <div>
            <strong>Elena Cucchi</strong>
          </div>
        </div>

        <p class="anniversary-note">
          Trent’anni di banco, consigli, scuola, ufficio e servizi con la stessa attenzione di sempre!
        </p>
      </div>
    </div>
  </section>

  <section id="catalogo-prodotti" class="section catalog-section" aria-labelledby="catalog-title">
    <div class="container catalog-layout">
      <aside class="catalog-sidebar" aria-label="Categorie prodotto">
        {productCategories.map((category) => (
          <a href={category.href}>
            <span>{category.label}</span>
            <ArrowRight size={18} stroke-width={2.2} />
          </a>
        ))}
      </aside>

      <div class="catalog-main">
        <div class="section-head">
          <span class="eyebrow">Prodotti</span>
          <h2 id="catalog-title">Prodotti Buffetti, divisi come li cerchi davvero.</h2>
          <p>
            Ogni categoria apre una pagina propria con prodotti, sottocategorie e immagini:
            niente link finti, niente girotondi, solo percorsi chiari per arrivare al banco preparato.
          </p>
        </div>

        <div class="category-grid">
          {heroCategories.map((category) => (
            <a class="category-card" href={category.href}>
              <img
                class="category-card__image"
                src={categoryImages[category.slug]}
                alt={`Prodotti Buffetti per ${category.label.toLowerCase()}`}
                loading="lazy"
              />
              <h3>{category.label}</h3>
              <p>{category.summary}</p>
              <ul>
                {category.items.slice(0, 4).map((item) => <li>{item}</li>)}
              </ul>
            </a>
          ))}
        </div>

        <div class="mobile-category-list">
          {heroCategories.map((category) => (
            <details class="mobile-category-card" name="product-categories">
              <summary>
                <h3>{category.label}</h3>
                <ChevronDown size={20} stroke-width={2.4} aria-hidden="true" />
              </summary>
              <a class="mobile-category-card__content" href={category.href}>
                <img
                  src={categoryImages[category.slug]}
                  alt={`Prodotti Buffetti per ${category.label.toLowerCase()}`}
                  loading="lazy"
                />
                <p>{category.summary}</p>
                <ul>
                  {category.items.slice(0, 4).map((item) => <li>{item}</li>)}
                </ul>
                <span class="mobile-category-card__action">
                  Scopri la categoria
                  <ArrowRight size={18} stroke-width={2.3} aria-hidden="true" />
                </span>
              </a>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section departments-section" aria-labelledby="departments-title">
    <div class="container business-layout">
      <div class="business-copy">
        <span class="eyebrow">Reparti del negozio</span>
        <h2 id="departments-title">Non un portale corporate: un negozio con reparti chiari.</h2>
        <p>
          Scuola, ufficio, servizi al banco e idee regalo restano percorsi autonomi,
          con immagini e contenuti pensati per chi passa fisicamente da Buffetti Cucchi.
        </p>
      </div>

      <div class="business-list">
        {shopFocusAreas.map((area) => (
          <a href={area.href}>
            <img src={area.image} alt="" loading="lazy" />
            <strong>{area.label}</strong>
            <span>{area.text}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section social-section" aria-labelledby="social-title">
    <div class="container social-layout">
      <div class="social-copy">
        <span class="eyebrow">Segui il negozio</span>
        <h2 id="social-title">Novità, vetrine e contatti veloci anche sui social.</h2>
        <p>
          Facebook e Instagram servono davvero: per vedere cosa arriva in negozio,
          chiedere informazioni e restare aggiornato su scuola, cartoleria, servizi e idee regalo.
        </p>
      </div>

      <div class="social-cards">
        <a href={site.facebook} target="_blank" rel="noopener noreferrer">
          <img src="/images/facebook.svg" alt="" loading="lazy" />
          <strong>Facebook</strong>
          <span>Pagina Buffetti Cucchi</span>
        </a>
        <a href={site.instagram} target="_blank" rel="noopener noreferrer">
          <img src="/images/instagram.svg" alt="" loading="lazy" />
          <strong>Instagram</strong>
          <span>Vetrine e novità</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section services-section" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Servizi digitali e documenti</span>
        <h2 id="services-title">PEC, firma, SPID e stampa senza rimbalzare tra mille sportelli.</h2>
      </div>

      <div class="service-grid">
        {serviceCards.map((service) => (
          <a class="service-card" href={service.href}>
            <img
              class="service-card__image"
              src={serviceImages[service.label]}
              alt={`Servizio Buffetti: ${service.label}`}
              loading="lazy"
            />
            <h3>{service.label}</h3>
            <p>{service.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section visit-section" aria-labelledby="visit-title">
    <div class="container visit-layout">
      <div class="visit-copy">
        <span class="eyebrow">Negozio Buffetti a Cesena</span>
        <h2 id="visit-title">Vedi, confronti, chiedi. E torni a casa con la cosa giusta.</h2>
        <p>
          Ci trovi in Viale Matteotti, 593, zona Ippodromo. Passa per prodotti Buffetti,
          scuola, ufficio, servizi digitali, fotocopie, timbri, rilegature e spedizioni.
        </p>

        <div class="visit-facts">
          <div>
            <span>Telefono</span>
            <strong>{site.phone}</strong>
          </div>
          <div>
            <span>Orari</span>
            <strong>Lun-Ven 8:30-12:30 / 15:30-19:00</strong>
          </div>
          <div>
            <span>Indirizzo</span>
            <strong>Viale Matteotti, 593 - Cesena</strong>
          </div>
        </div>

        <div class="visit-actions">
          <a class="btn btn--primary" href={site.phoneHref}>
            <Phone size={18} stroke-width={2.2} />
            Chiama il negozio
          </a>
          <a class="btn btn--ghost" href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
            <MapPin size={18} stroke-width={2.2} />
            Ottieni indicazioni
          </a>
        </div>
      </div>

      <div class="visit-map">
        <iframe
          src={site.mapsEmbedUrl}
          title="Mappa Buffetti Cucchi Cesena"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .eyebrow {
    display: inline-flex;
    margin-bottom: 16px;
    color: #0000e8;
    font-size: 0.76rem;
    font-weight: 840;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .home-hero {
    position: relative;
    min-height: 620px;
    display: grid;
    align-items: center;
    overflow: hidden;
    color: #fff;
    background: #001f45;
  }

  .home-hero__media {
    position: absolute;
    inset: 0;
  }

  .home-hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(0, 16, 46, 0.94), rgba(0, 18, 60, 0.72) 48%, rgba(0, 0, 232, 0.16)),
      linear-gradient(0deg, rgba(0, 12, 34, 0.68), transparent 62%);
  }

  .home-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-hero__inner {
    position: relative;
    z-index: 1;
    padding: 90px 0 74px;
  }

  .home-hero__content {
    max-width: 760px;
  }

  .home-hero .eyebrow {
    color: #fff;
    padding: 8px 12px;
    background: #0000e8;
    border-radius: 4px;
  }

  .home-hero h1 {
    margin: 0;
    color: #fff;
    font-size: clamp(2.8rem, 5.2vw, 5.3rem);
    line-height: 0.94;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .home-hero p {
    max-width: 650px;
    margin: 24px 0 0;
    color: rgba(255, 255, 255, 0.84);
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .hero-search {
    width: min(100%, 660px);
    height: 58px;
    margin-top: 32px;
    display: grid;
    grid-template-columns: 1fr 58px;
    overflow: hidden;
    border-radius: 999px;
    border: 1.5px solid rgba(255, 255, 255, 0.9);
    background: #fff;
    box-shadow: 0 20px 58px rgba(0, 0, 0, 0.22);
  }

  .hero-search input {
    min-width: 0;
    padding: 0 24px;
    border: 0;
    outline: 0;
    color: var(--color-primary-dark);
  }

  .hero-search button {
    border: 0;
    color: #0000e8;
    background: #fff;
    cursor: pointer;
  }

  .home-hero__actions {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .anniversary-section {
    position: relative;
    overflow: hidden;
    padding: clamp(72px, 8vw, 118px) 0;
    background:
      radial-gradient(circle at 8% 18%, rgba(230, 184, 74, 0.24), transparent 28%),
      radial-gradient(circle at 94% 82%, rgba(0, 166, 232, 0.16), transparent 30%),
      linear-gradient(135deg, #f7faff 0%, #fffaf0 100%);
  }

  .anniversary-section::before {
    content: "30";
    position: absolute;
    right: -0.04em;
    bottom: -0.28em;
    color: rgba(0, 31, 69, 0.035);
    font-size: clamp(15rem, 34vw, 35rem);
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.1em;
    pointer-events: none;
  }

  .anniversary-card {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(420px, 0.92fr);
    overflow: hidden;
    border: 1px solid rgba(0, 31, 69, 0.1);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 36px 110px rgba(0, 31, 69, 0.14);
  }

  .anniversary-portrait {
    position: relative;
    min-height: 540px;
    margin: 0;
    overflow: hidden;
    background: #001f45;
  }

  .anniversary-portrait::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 48%, rgba(0, 20, 48, 0.84) 100%);
    pointer-events: none;
  }

  .anniversary-portrait > img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    object-position: center;
  }

  .anniversary-seal {
    position: absolute;
    z-index: 2;
    bottom: 24px;
    left: 30px;
    width: 144px;
    height: 144px;
    display: grid;
    place-content: center;
    text-align: center;
    color: #001f45;
    border: 6px solid rgba(255, 255, 255, 0.76);
    border-radius: 999px;
    background: #e6b84a;
    box-shadow: 0 20px 50px rgba(0, 31, 69, 0.26);
    transform: rotate(-6deg);
  }

  .anniversary-seal strong {
    display: block;
    font-size: 4.2rem;
    line-height: 0.78;
    letter-spacing: -0.08em;
  }

  .anniversary-seal span {
    margin-top: 9px;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .anniversary-portrait figcaption {
    position: absolute;
    z-index: 2;
    right: 30px;
    bottom: 26px;
    left: 194px;
    max-width: 560px;
    color: #fff;
    font-size: 1rem;
    font-weight: 760;
    line-height: 1.5;
  }

  .anniversary-copy {
    padding: clamp(42px, 5vw, 72px);
    align-self: center;
  }

  .anniversary-copy .eyebrow {
    color: #8b6506;
  }

  .anniversary-copy h2 {
    margin: 0;
    color: var(--color-primary-dark);
    font-size: clamp(2.35rem, 4.2vw, 4.35rem);
    line-height: 0.96;
    letter-spacing: -0.052em;
    text-wrap: balance;
  }

  .anniversary-lead {
    margin: 24px 0 0;
    color: var(--color-muted);
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .anniversary-family {
    margin-top: 30px;
    display: grid;
    gap: 10px;
  }

  .anniversary-family div {
    padding: 13px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    border-left: 4px solid #e6b84a;
    background: #f4f7fb;
  }

  .anniversary-family strong {
    color: #001f45;
    font-size: 0.98rem;
  }

  .anniversary-family span {
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 700;
    text-align: right;
  }

  .anniversary-note {
    margin: 28px 0 0;
    padding-top: 22px;
    color: #001f45;
    border-top: 1px solid #dfe7f0;
    font-size: 1.02rem;
    font-weight: 820;
    line-height: 1.55;
  }

  .catalog-section {
    scroll-margin-top: 184px;
    background: #fff;
  }

  .catalog-layout {
    display: grid;
    grid-template-columns: 270px minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }

  .catalog-sidebar {
    position: sticky;
    top: 226px;
    display: grid;
    border-right: 1px solid #dce4ef;
  }

  .catalog-sidebar a {
    min-height: 52px;
    padding: 0 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    color: #050915;
    font-weight: 780;
    border-bottom: 1px solid #edf2f7;
  }

  .catalog-sidebar a:hover,
  .catalog-sidebar a:focus-visible {
    color: #0000e8;
    background: #eef3ff;
  }

  .section-head {
    max-width: 780px;
    margin-bottom: 40px;
  }

  .section-head--center {
    margin-inline: auto;
    text-align: center;
  }

  .section-head h2,
  .business-copy h2,
  .visit-copy h2 {
    margin: 0;
    color: var(--color-primary-dark);
    font-size: clamp(2.1rem, 4.2vw, 3.75rem);
    line-height: 0.98;
    letter-spacing: -0.048em;
  }

  .section-head p,
  .business-copy p,
  .visit-copy p {
    margin: 20px 0 0;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.78;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .mobile-category-list {
    display: none;
  }

  .category-card,
  .service-card,
  .business-list a {
    border: 1px solid #dfe8f2;
    background: #fff;
    border-radius: 4px;
    box-shadow: 0 16px 44px rgba(0, 31, 69, 0.07);
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .category-card:hover,
  .service-card:hover,
  .business-list a:hover {
    transform: translateY(-4px);
    border-color: rgba(0, 0, 232, 0.3);
    box-shadow: 0 22px 54px rgba(0, 31, 69, 0.12);
  }

  .category-card {
    min-height: 418px;
    padding: 0 24px 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .category-card__image,
  .service-card__image {
    width: calc(100% + 48px);
    max-width: none;
    height: 160px;
    margin: 0 -24px 22px;
    display: block;
    object-fit: cover;
    background: #f4f7fb;
  }

  .category-card__image {
    height: 176px;
  }

  .category-card h3,
  .service-card h3 {
    margin: 0;
    color: #0000e8;
    font-size: 1.18rem;
    font-weight: 860;
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .category-card p,
  .service-card p {
    margin: 12px 0 0;
    color: var(--color-muted);
    line-height: 1.58;
  }

  .category-card ul {
    margin: auto 0 0;
    padding-top: 20px;
    padding-left: 0;
    padding-right: 0;
    padding-bottom: 0;
    display: grid;
    gap: 8px;
    list-style: none;
  }

  .category-card li {
    position: relative;
    padding-left: 16px;
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 720;
  }

  .category-card li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.58em;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #00a6e8;
  }

  .departments-section {
    background: #f5f8fc;
  }

  .business-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 64px;
    align-items: center;
  }

  .business-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .business-list a {
    min-height: 164px;
    padding: 20px;
  }

  .business-list img {
    width: 100%;
    height: 72px;
    object-fit: contain;
    margin-bottom: 14px;
  }

  .business-list strong,
  .business-list span {
    display: block;
  }

  .business-list strong {
    color: var(--color-primary-dark);
    font-size: 1.04rem;
  }

  .social-section {
    background:
      linear-gradient(135deg, rgba(0, 0, 232, 0.08), rgba(0, 166, 232, 0.08)),
      #fff;
  }

  .social-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.72fr);
    gap: 64px;
    align-items: center;
  }

  .social-copy h2 {
    margin: 0;
    color: var(--color-primary-dark);
    font-size: clamp(2.1rem, 4.2vw, 3.75rem);
    line-height: 0.98;
    letter-spacing: -0.048em;
  }

  .social-copy p {
    margin: 20px 0 0;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.78;
  }

  .social-cards {
    display: grid;
    gap: 14px;
  }

  .social-cards a {
    min-height: 108px;
    padding: 22px;
    display: grid;
    grid-template-columns: 46px 1fr;
    align-items: center;
    gap: 4px 14px;
    border: 1px solid #dfe8f2;
    border-radius: 4px;
    background: #fff;
    box-shadow: 0 16px 44px rgba(0, 31, 69, 0.08);
    transition: transform 0.18s ease;
  }

  .social-cards a:hover {
    transform: translateY(-4px);
  }

  .social-cards img {
    width: 26px;
    height: 26px;
    grid-row: span 2;
  }

  .social-cards strong {
    color: var(--color-primary-dark);
    font-size: 1.08rem;
  }

  .social-cards span {
    color: var(--color-muted);
  }

  .business-list span {
    margin-top: 7px;
    color: var(--color-muted);
    line-height: 1.45;
  }

  .services-section {
    color: #fff;

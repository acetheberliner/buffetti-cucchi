      margin: 0 -16px 16px;
      object-fit: cover;
    }

    .mobile-category-card__content p {
      margin: 0;
      color: var(--color-muted);
      font-size: 0.94rem;
      line-height: 1.55;
    }

    .mobile-category-card__content ul {
      margin: 16px 0 0;
      padding: 0;
      display: grid;
      gap: 7px;
      list-style: none;
    }

    .mobile-category-card__content li {
      position: relative;
      padding-left: 15px;
      color: var(--color-text);
      font-size: 0.88rem;
      font-weight: 720;
      line-height: 1.4;
    }

    .mobile-category-card__content li::before {
      content: "";
      position: absolute;
      top: 0.55em;
      left: 0;
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: #00a6e8;
    }

    .mobile-category-card__action {
      min-height: 44px;
      margin-top: 16px;
      padding-top: 12px;

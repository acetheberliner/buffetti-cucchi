---
import BaseLayout from '../layouts/BaseLayout.astro';
import { digitalServices, productCategories, shopFocusAreas } from '../data/catalog';
import { categoryCardImages as categoryImages, serviceCardImages as serviceImages } from '../data/card-images';
import { site } from '../data/site';
import { ArrowRight, ChevronDown, Clock3, MapPin, Phone, RefreshCw, ShieldCheck, Smartphone } from '@lucide/astro';

const heroCategories = productCategories;
const serviceCards = digitalServices.slice(0, 4);

---

<BaseLayout
  title="Buffetti Cucchi Cesena | Cartoleria e servizi"
  description="Cartoleria Buffetti a Cesena: prodotti per scuola e ufficio, cancelleria, PEC, firma digitale, fotocopie, spedizioni e assistenza in negozio."
  preloadImage="/images/hero-home.webp"
>
  <section class="home-hero">
    <div class="home-hero__media">
      <img
        src="/images/hero-home.webp"
        alt="Esterno della cartoleria Buffetti Cucchi a Cesena"
        width="1920"
        height="662"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <div class="container home-hero__inner">
      <div class="home-hero__content">
        <span class="eyebrow">Buffetti Cucchi Cesena</span>
        <h1>Tutto ciò che cerchi per la tua attività</h1>
        <p>
          Prodotti Buffetti, servizi digitali, stampa, spedizioni, scuola e ufficio:
          scegli online cosa ti serve e poi parlane con chi lo conosce davvero.
        </p>

        <div class="home-hero__actions">
          <a class="btn btn--primary" href={site.phoneHref}>
            <Phone size={18} stroke-width={2.2} class="cta-icon" />
            Chiama ora
          </a>
          <a class="btn btn--ghost" href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
            <MapPin size={18} stroke-width={2.2} class="cta-icon" />
            Vieni in negozio
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="anniversary-section" aria-labelledby="anniversary-title">
    <div class="container anniversary-card">
      <figure class="anniversary-portrait">
        <img
          src="/images/staff.png"
          alt="Sandra Casadei, Elisabetta Cucchi ed Elena Cucchi nel negozio Buffetti Cucchi"
          width="749"
          height="609"
          loading="eager"
          decoding="async"
        />

        <div class="anniversary-seal" aria-hidden="true">
          <strong>30</strong>
          <span>anni insieme</span>
        </div>

        <figcaption>Due generazioni, la stessa cura per il negozio e per chi entra a farci visita ogni giorno!</figcaption>
      </figure>

      <div class="anniversary-copy">
        <span class="eyebrow">30° anniversario · Una storia di famiglia</span>
        <h2 id="anniversary-title">Da trent’anni a Cesena!</h2>
        <p class="anniversary-lead">
          Buffetti Cucchi è prima di tutto una storia familiare: esperienza, presenza quotidiana
          e un modo diretto di aiutare le persone a trovare ciò che serve davvero.
        </p>

        <div class="anniversary-family" aria-label="La famiglia Buffetti Cucchi">
          <div>
            <strong>Sandra Casadei</strong>
          </div>
          <div>
            <strong>Elisabetta Cucchi</strong>
          </div>
          <div>
            <strong>Elena Cucchi</strong>
          </div>
        </div>

        <p class="anniversary-note">
          Trent’anni di banco, consigli, scuola, ufficio e servizi con la stessa attenzione di sempre!
        </p>
      </div>
    </div>
  </section>

  <section id="catalogo-prodotti" class="section catalog-section" aria-labelledby="catalog-title">
    <div class="container catalog-layout">
      <aside class="catalog-sidebar" aria-label="Categorie prodotto">
        {productCategories.map((category) => (
          <a href={category.href}>
            <span>{category.label}</span>
            <ArrowRight size={18} stroke-width={2.2} />
          </a>
        ))}
      </aside>

      <div class="catalog-main">
        <div class="section-head">
          <span class="eyebrow">Prodotti</span>
          <h2 id="catalog-title">La famiglia di prodotti Buffetti</h2>
          <p>
            Ogni categoria apre una pagina propria con prodotti, sottocategorie e immagini:
            niente link finti, niente girotondi, solo percorsi chiari per arrivare al banco preparato.
          </p>
        </div>

        <div class="category-grid">
          {heroCategories.map((category) => (
            <a class="category-card" href={category.href}>
              <img
                class="category-card__image"
                src={categoryImages[category.slug]}
                alt={`Prodotti Buffetti per ${category.label.toLowerCase()}`}
                loading="lazy"
              />
              <h3>{category.label}</h3>
              <p>{category.summary}</p>
              <ul>
                {category.items.slice(0, 4).map((item) => <li>{item}</li>)}
              </ul>
            </a>
          ))}
        </div>

        <div class="mobile-category-list">
          {heroCategories.map((category) => (
            <details class="mobile-category-card" name="product-categories">
              <summary>
                <h3>{category.label}</h3>
                <ChevronDown size={20} stroke-width={2.4} aria-hidden="true" />
              </summary>
              <a class="mobile-category-card__content" href={category.href}>
                <img
                  src={categoryImages[category.slug]}
                  alt={`Prodotti Buffetti per ${category.label.toLowerCase()}`}
                  loading="lazy"
                />
                <p>{category.summary}</p>
                <ul>
                  {category.items.slice(0, 4).map((item) => <li>{item}</li>)}
                </ul>
                <span class="mobile-category-card__action">
                  Scopri la categoria
                  <ArrowRight size={18} stroke-width={2.3} aria-hidden="true" />
                </span>
              </a>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="buffetti-rent" class="rent-teaser" aria-labelledby="rent-teaser-title">
    <div class="container rent-teaser__card">
      <div class="rent-teaser__copy">
        <span class="eyebrow">Novità · Buffetti Rent</span>
        <h2 id="rent-teaser-title">Il prossimo smartphone di lavoro? Noleggialo.</h2>
        <p>
          Se hai una Partita IVA puoi accedere a smartphone di ultima generazione con un
          canone mensile, senza immobilizzare capitale e con assistenza inclusa nelle condizioni del servizio.
        </p>

        <div class="rent-teaser__benefits" aria-label="Vantaggi di Buffetti Rent">
          <span><RefreshCw size={18} stroke-width={2.2} /> Tecnologia aggiornata</span>
          <span><ShieldCheck size={18} stroke-width={2.2} /> Più continuità operativa</span>
        </div>

        <a class="rent-teaser__cta" href="/servizi.html#buffetti-rent">
          Scopri Buffetti Rent
          <ArrowRight size={19} stroke-width={2.3} aria-hidden="true" />
        </a>
      </div>

      <div class="rent-teaser__visual" aria-label="Smartphone disponibili con Buffetti Rent">
        <div class="rent-teaser__price">
          <span>Smartphone da</span>
          <strong>27,50 €</strong>
          <small>al mese</small>
        </div>
        <div class="rent-teaser__phone">
          <img
            src="https://buffetti.it/cdn/shop/files/IPhone-17-PRO-5G.jpg?v=1778677076&width=1100"
            alt="iPhone 17 Pro disponibile nella gamma Buffetti Rent"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section departments-section" aria-labelledby="departments-title">
    <div class="container business-layout">
      <div class="business-copy">
        <span class="eyebrow">Reparti del negozio</span>
        <h2 id="departments-title">Tutto al posto giusto</h2>
        <p>
          Scuola, ufficio, servizi, regali e molto di piu, tutto organizzato per trovare subito ciò che cerchi.
        </p>
      </div>

      <div class="business-list">
        {shopFocusAreas.map((area) => (
          <a href={area.href}>
            <img src={area.image} alt="" loading="lazy" />
            <strong>{area.label}</strong>
            <span>{area.text}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section services-section" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Servizi digitali e documenti</span>
        <h2 id="services-title">Assistenza concreta per documenti e servizi</h2>
      </div>

      <div class="service-grid">
        {serviceCards.map((service) => (
          <a class="service-card" href={service.href}>
            <img
              class="service-card__image"
              src={serviceImages[service.label]}
              alt={`Servizio Buffetti: ${service.label}`}
              loading="lazy"
            />
            <h3>{service.label}</h3>
            <p>{service.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section social-section" aria-labelledby="social-title">
    <div class="container social-layout">
      <div class="social-copy">
        <span class="eyebrow">Segui il negozio</span>
        <h2 id="social-title">Scopri Buffetti anche sui nostri social</h2>
        <p>
          Tutto quello che serve per restare aggiornato su prodotti, servizi e iniziative.
        </p>
      </div>

      <div class="social-cards">
        <a class="social-profile social-profile--facebook" href={site.facebook} target="_blank" rel="noopener noreferrer">
          <div class="social-profile__info">
            <span class="social-profile__icon"><img src="/images/facebook.svg" alt="" /></span>
            <div>
              <strong>Facebook</strong>
              <span>@CucchiSas</span>
            </div>
            <span class="social-profile__cta">
              Segui la pagina
              <ArrowRight size={17} stroke-width={2.3} aria-hidden="true" />
            </span>
          </div>
          <div class="social-profile__gallery" aria-hidden="true">
            <img src="/images/staff.png" alt="" loading="lazy" />
            <img src="/images/hero-cancelleria.webp" alt="" loading="lazy" />
            <img src="/images/hero-scuola.webp" alt="" loading="lazy" />
            <img src="/images/hero-regalistica.webp" alt="" loading="lazy" />
          </div>
        </a>
        <a class="social-profile social-profile--instagram" href={site.instagram} target="_blank" rel="noopener noreferrer">
          <div class="social-profile__info">
            <span class="social-profile__icon"><img src="/images/instagram.svg" alt="" /></span>
            <div>
              <strong>Instagram</strong>
              <span>@cucchi_sas_cesena_buffetti_</span>
            </div>
            <span class="social-profile__cta">
              Segui il profilo
              <ArrowRight size={17} stroke-width={2.3} aria-hidden="true" />
            </span>
          </div>
          <div class="social-profile__gallery" aria-hidden="true">
            <img src="/images/index-meta.jpg" alt="" loading="lazy" />
            <img src="/images/staff.png" alt="" loading="lazy" />
            <img src="/images/hero-contatti.webp" alt="" loading="lazy" />
            <img src="/images/hero-arredamento.webp" alt="" loading="lazy" />
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="section visit-section" aria-labelledby="visit-title">
    <div class="container visit-layout">
      <div class="visit-copy">
        <span class="eyebrow">Negozio Buffetti a Cesena</span>
        <h2 id="visit-title">Vieni a farci visita?</h2>
        <p>
          Ci trovi in Viale Matteotti, 593, zona Ippodromo. Passa per prodotti Buffetti,
          scuola, ufficio, servizi digitali, fotocopie, timbri, rilegature e spedizioni.
        </p>

        <div class="visit-facts">
          <div class="visit-fact">
            <span>Telefono</span>
            <strong>{site.phone}</strong>
          </div>
          <div class="visit-hours">
            <div class="visit-hours__heading">
              <span class="visit-hours__icon" aria-hidden="true">
                <Clock3 size={20} stroke-width={2.2} />
              </span>
              <div>
                <span>Orari aggiornati</span>
                <strong>Quando trovarci in negozio</strong>
              </div>
            </div>
            <dl class="visit-hours__list">
              <div>
                <dt>Lunedì – venerdì</dt>
                <dd><span>08:30–12:30</span><span>15:30–19:00</span></dd>
              </div>
              <div>
                <dt>Sabato</dt>
                <dd><strong>Chiuso</strong></dd>
              </div>
              <div>
                <dt>Domenica</dt>
                <dd><strong>Chiuso</strong></dd>
              </div>
            </dl>
            <p class="visit-hours__note">Il sabato il negozio resta chiuso per orario estivo</p>
          </div>
          <div class="visit-fact">
            <span>Indirizzo</span>
            <strong>Viale Matteotti, 593 - Cesena</strong>
          </div>
        </div>

        <div class="visit-actions">
          <a class="btn btn--primary" href={site.phoneHref}>
            <Phone size={18} stroke-width={2.2} />
            Chiama il negozio
          </a>
          <a class="btn btn--ghost" href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
            <MapPin size={18} stroke-width={2.2} />
            Ottieni indicazioni
          </a>
        </div>
      </div>

      <div class="visit-map">
        <iframe
          src={site.mapsEmbedUrl}
          title="Mappa Buffetti Cucchi Cesena"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .eyebrow {
    display: inline-flex;
    margin-bottom: 16px;
    color: #0000e8;
    font-size: 0.76rem;
    font-weight: 840;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .home-hero {
    position: relative;
    min-height: 620px;
    display: grid;
    align-items: center;
    overflow: hidden;
    color: #fff;
    background: #001f45;
  }

  .home-hero__media {
    position: absolute;
    inset: 0;
  }

  .home-hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(0, 16, 46, 0.94), rgba(0, 18, 60, 0.72) 48%, rgba(0, 0, 232, 0.16)),
      linear-gradient(0deg, rgba(0, 12, 34, 0.68), transparent 62%);
  }

  .home-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-hero__inner {
    position: relative;
    z-index: 1;
    padding: 90px 0 74px;
  }

  .home-hero__content {
    max-width: 760px;
  }

  .home-hero .eyebrow {
    color: #fff;
    padding: 8px 12px;
    background: #0000e8;
    border-radius: 4px;
  }

  .home-hero h1 {
    margin: 0;
    color: #fff;
    font-size: clamp(2.8rem, 5.2vw, 5.3rem);
    line-height: 0.94;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .home-hero p {
    max-width: 650px;
    margin: 24px 0 0;
    color: rgba(255, 255, 255, 0.84);
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .hero-search {
    width: min(100%, 660px);
    height: 58px;
    margin-top: 32px;
    display: grid;
    grid-template-columns: 1fr 58px;
    overflow: hidden;
    border-radius: 999px;
    border: 1.5px solid rgba(255, 255, 255, 0.9);
    background: #fff;
    box-shadow: 0 20px 58px rgba(0, 0, 0, 0.22);
  }

  .hero-search input {
    min-width: 0;
    padding: 0 24px;
    border: 0;
    outline: 0;
    color: var(--color-primary-dark);
  }

  .hero-search button {
    border: 0;
    color: #0000e8;
    background: #fff;
    cursor: pointer;
  }

  .home-hero__actions {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .anniversary-section {
    position: relative;
    overflow: hidden;
    padding: clamp(72px, 8vw, 118px) 0;
    background:
      radial-gradient(circle at 8% 18%, rgba(230, 184, 74, 0.24), transparent 28%),
      radial-gradient(circle at 94% 82%, rgba(0, 166, 232, 0.16), transparent 30%),
      linear-gradient(135deg, #f7faff 0%, #fffaf0 100%);
  }

  .anniversary-section::before {
    content: "30";
    position: absolute;
    right: -0.04em;
    bottom: -0.28em;
    color: rgba(0, 31, 69, 0.035);
    font-size: clamp(15rem, 34vw, 35rem);
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.1em;
    pointer-events: none;
  }

  .anniversary-card {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(420px, 0.92fr);
    overflow: hidden;
    border: 1px solid rgba(0, 31, 69, 0.1);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 36px 110px rgba(0, 31, 69, 0.14);
  }

  .anniversary-portrait {
    position: relative;
    min-height: 540px;
    margin: 0;
    overflow: hidden;
    background: #001f45;
  }

  .anniversary-portrait::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 48%, rgba(0, 20, 48, 0.84) 100%);
    pointer-events: none;
  }

  .anniversary-portrait > img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    object-position: center;
  }

  .anniversary-seal {
    position: absolute;
    z-index: 2;
    bottom: 24px;
    left: 30px;
    width: 144px;
    height: 144px;
    display: grid;
    place-content: center;
    text-align: center;
    color: #001f45;
    border: 6px solid rgba(255, 255, 255, 0.76);
    border-radius: 999px;
    background: #e6b84a;
    box-shadow: 0 20px 50px rgba(0, 31, 69, 0.26);
    transform: rotate(-6deg);
  }

  .anniversary-seal strong {
    display: block;
    font-size: 4.2rem;
    line-height: 0.78;
    letter-spacing: -0.08em;
  }

  .anniversary-seal span {
    margin-top: 9px;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .anniversary-portrait figcaption {
    position: absolute;
    z-index: 2;
    right: 30px;
    bottom: 26px;
    left: 194px;
    max-width: 560px;
    color: #fff;
    font-size: 1rem;
    font-weight: 760;
    line-height: 1.5;
  }

  .anniversary-copy {
    padding: clamp(42px, 5vw, 72px);
    align-self: center;
  }

  .anniversary-copy .eyebrow {
    color: #8b6506;
  }

  .anniversary-copy h2 {
    margin: 0;
    color: var(--color-primary-dark);
    font-size: clamp(2.35rem, 4.2vw, 4.35rem);
    line-height: 0.96;
    letter-spacing: -0.052em;
    text-wrap: balance;
  }

  .anniversary-lead {
    margin: 24px 0 0;
    color: var(--color-muted);
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .anniversary-family {
    margin-top: 30px;
    display: grid;
    gap: 10px;
  }

  .anniversary-family div {
    padding: 13px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    border-left: 4px solid #e6b84a;
    background: #f4f7fb;
  }

  .anniversary-family strong {
    color: #001f45;
    font-size: 0.98rem;
  }

  .anniversary-family span {
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 700;
    text-align: right;
  }

  .anniversary-note {
    margin: 28px 0 0;
    padding-top: 22px;
    color: #001f45;
    border-top: 1px solid #dfe7f0;
    font-size: 1.02rem;
    font-weight: 820;
    line-height: 1.55;
  }

  .catalog-section {
    scroll-margin-top: 184px;
    background: #fff;
  }

  .catalog-layout {
    display: grid;
    grid-template-columns: 270px minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }

  .catalog-sidebar {
    position: sticky;
    top: 226px;
    display: grid;
    border-right: 1px solid #dce4ef;
  }

  .catalog-sidebar a {
    min-height: 52px;
    padding: 0 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    color: #050915;
    font-weight: 780;
    border-bottom: 1px solid #edf2f7;
  }

  .catalog-sidebar a:hover,
  .catalog-sidebar a:focus-visible {
    color: #0000e8;
    background: #eef3ff;
  }

  .section-head {
    max-width: 780px;
    margin-bottom: 40px;
  }

  .section-head--center {
    margin-inline: auto;
    text-align: center;
  }

  .section-head h2,
  .business-copy h2,
  .visit-copy h2 {
    margin: 0;
    color: var(--color-primary-dark);
    font-size: clamp(2.1rem, 4.2vw, 3.75rem);
    line-height: 0.98;
    letter-spacing: -0.048em;
  }

  .section-head p,
  .business-copy p,
  .visit-copy p {
    margin: 20px 0 0;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.78;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .mobile-category-list {
    display: none;
  }

  .category-card,
  .service-card,
  .business-list a {
    border: 1px solid #dfe8f2;
    background: #fff;
    border-radius: 4px;
    box-shadow: 0 16px 44px rgba(0, 31, 69, 0.07);
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .category-card:hover,
  .service-card:hover,
  .business-list a:hover {
    transform: translateY(-4px);
    border-color: rgba(0, 0, 232, 0.3);
    box-shadow: 0 22px 54px rgba(0, 31, 69, 0.12);
  }

  .category-card {
    min-height: 418px;
    padding: 0 24px 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .category-card__image,
  .service-card__image {
    width: calc(100% + 48px);
    max-width: none;
    height: 160px;
    margin: 0 -24px 22px;
    display: block;
    object-fit: cover;
    background: #f4f7fb;
  }

  .category-card__image {
    height: 176px;
  }

  .category-card h3,
  .service-card h3 {
    margin: 0;
    color: #0000e8;
    font-size: 1.18rem;
    font-weight: 860;
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .category-card p,
  .service-card p {
    margin: 12px 0 0;
    color: var(--color-muted);
    line-height: 1.58;
  }

  .category-card ul {
    margin: auto 0 0;
    padding-top: 20px;
    padding-left: 0;
    padding-right: 0;
    padding-bottom: 0;
    display: grid;
    gap: 8px;
    list-style: none;
  }

  .category-card li {
    position: relative;
    padding-left: 16px;
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 720;
  }

  .category-card li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.58em;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #00a6e8;
  }

  .departments-section {
    background: #f5f8fc;
  }

  .rent-teaser {
    padding: clamp(68px, 8vw, 112px) 0;
    overflow: hidden;
    color: #fff;
    background: #f5f8fc;
  }

  .rent-teaser__card {
    position: relative;
    min-height: 510px;
    padding: clamp(42px, 6vw, 78px);
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(330px, 0.72fr);
    align-items: center;
    gap: clamp(36px, 7vw, 92px);
    overflow: hidden;
    border-radius: 28px;
    background:
      radial-gradient(circle at 80% 22%, rgba(0, 166, 232, 0.32), transparent 28%),
      linear-gradient(132deg, #001f45 0%, #003b7a 56%, #0000e8 130%);
    box-shadow: 0 34px 90px rgba(0, 31, 69, 0.2);
  }

  .rent-teaser__card::after {
    content: "RENT";
    position: absolute;
    right: -0.04em;
    bottom: -0.25em;
    color: rgba(255, 255, 255, 0.045);
    font-size: clamp(10rem, 22vw, 21rem);
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.09em;
    pointer-events: none;
  }

  .rent-teaser__copy,
  .rent-teaser__visual {
    position: relative;
    z-index: 1;
  }

  .rent-teaser .eyebrow {
    color: #8be0ff;
  }

  .rent-teaser h2 {
    max-width: 720px;
    margin: 0;
    color: #fff;
    font-size: clamp(2.5rem, 5vw, 5rem);
    line-height: 0.94;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .rent-teaser__copy > p {
    max-width: 650px;
    margin: 24px 0 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 1.06rem;
    line-height: 1.72;
  }

  .rent-teaser__benefits {
    margin-top: 26px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .rent-teaser__benefits span,
  .rent-teaser__device-label {
    min-height: 42px;
    padding: 0 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    font-size: 0.9rem;
    font-weight: 760;
  }

  .rent-teaser__benefits svg {
    color: #8be0ff;
    flex: 0 0 auto;
  }

  .rent-teaser__cta {
    min-height: 52px;
    width: fit-content;
    margin-top: 30px;
    padding: 0 20px;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: #001f45;
    border-radius: 4px;
    background: #fff;
    font-weight: 840;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .rent-teaser__cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.2);
  }

  .rent-teaser__visual {
    min-height: 370px;
    display: grid;
    place-items: center;
  }

  .rent-teaser__visual::before {
    content: "";
    position: absolute;
    width: min(100%, 390px);
    aspect-ratio: 1;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    box-shadow: inset 0 0 0 28px rgba(255, 255, 255, 0.025);
  }

  .rent-teaser__phone {
    position: relative;
    width: min(76%, 290px);
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 26px;
    background: #fff;
    box-shadow: 0 32px 70px rgba(0, 0, 0, 0.28);
    transform: rotate(4deg);
  }

  .rent-teaser__phone img {
    width: 100%;
    height: 100%;
    padding: 18px;
    object-fit: contain;
  }

  .rent-teaser__price {
    position: absolute;
    z-index: 2;
    top: 4px;
    left: 0;
    min-width: 148px;
    padding: 16px 18px;
    color: #001f45;
    border-radius: 14px;
    background: #8be0ff;
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.2);
    transform: rotate(-4deg);
  }

  .rent-teaser__price span,
  .rent-teaser__price small,
  .rent-teaser__price strong {
    display: block;
  }

  .rent-teaser__price span,
  .rent-teaser__price small {
    font-size: 0.74rem;
    font-weight: 820;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .rent-teaser__price strong {
    margin: 4px 0;
    font-size: 1.75rem;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .rent-teaser__device-label {
    position: absolute;
    right: 0;
    bottom: 14px;
    color: #fff;
    background: rgba(0, 20, 48, 0.72);
    backdrop-filter: blur(10px);
  }

  .business-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 64px;
    align-items: center;
  }

  .business-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .business-list a {
    min-height: 164px;
    padding: 20px;
  }

  .business-list img {
    width: 100%;
    height: 72px;
    object-fit: contain;
    margin-bottom: 14px;
  }

  .business-list strong,
  .business-list span {
    display: block;
  }

  .business-list strong {
    color: var(--color-primary-dark);
    font-size: 1.04rem;
  }

  .social-section {
    background:
      linear-gradient(135deg, rgba(0, 0, 232, 0.08), rgba(0, 166, 232, 0.08)),
      #fff;
  }

  .social-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(520px, 1.18fr);
    gap: 64px;
    align-items: center;
  }

  .social-copy h2 {
    margin: 0;
    color: var(--color-primary-dark);
    font-size: clamp(2.1rem, 4.2vw, 3.75rem);
    line-height: 0.98;
    letter-spacing: -0.048em;
  }

  .social-copy p {
    margin: 20px 0 0;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.78;
  }

  .social-cards {
    display: grid;
    gap: 16px;
  }

  .social-profile {
    min-height: 190px;
    padding: 16px;
    display: grid;
    grid-template-columns: minmax(220px, 1fr) 220px;
    gap: 20px;
    border: 1px solid #dfe8f2;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 16px 44px rgba(0, 31, 69, 0.08);
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .social-profile:hover {
    transform: translateY(-4px);
    border-color: rgba(0, 0, 232, 0.26);
    box-shadow: 0 24px 58px rgba(0, 31, 69, 0.13);
  }

  .social-profile__info {
    min-width: 0;
    padding: 8px 4px;
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    align-content: start;
    align-items: center;
    gap: 4px 14px;
  }

  .social-profile__icon {
    width: 48px;
    height: 48px;
    grid-row: span 2;
    display: grid;
    place-items: center;
    border-radius: 14px;
  }

  .social-profile--facebook .social-profile__icon {
    background: #eef2ff;
  }

  .social-profile--instagram .social-profile__icon {
    background: linear-gradient(145deg, #7c3aed, #ec4899 55%, #f59e0b);
  }

  .social-profile__icon img {
    width: 25px;
    height: 25px;
  }

  .social-profile--instagram .social-profile__icon img {
    filter: brightness(0) invert(1);
  }

  .social-profile__info strong {
    display: block;
    color: var(--color-primary-dark);
    font-size: 1.12rem;
    line-height: 1.2;
  }

  .social-profile__info > div > span {
    display: block;
    margin-top: 4px;
    color: var(--color-muted);
    font-size: 0.86rem;
    overflow-wrap: anywhere;
  }

  .social-profile__cta {
    min-height: 42px;
    width: fit-content;
    margin-top: 24px;
    padding: 0 15px;
    grid-column: 1 / -1;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: #fff;
    border-radius: 999px;
    background: #0000e8;
    font-size: 0.88rem;
    font-weight: 820;
  }

  .social-profile--instagram .social-profile__cta {
    background: #001f45;
  }

  .social-profile__gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, 1fr);
    gap: 8px;
  }

  .social-profile__gallery img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    border-radius: 10px;
  }

  .social-profile__gallery img:nth-child(2) {
    object-position: center 30%;
  }

  .business-list span {
    margin-top: 7px;
    color: var(--color-muted);
    line-height: 1.45;
  }

  .services-section {
    color: #fff;
    background: #0000e8;
  }

  .services-section .section-head {
    max-width: 900px;
    margin-bottom: 44px;
  }

  .services-section .eyebrow,
  .services-section h2 {
    color: #fff;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .service-card {
    min-height: 324px;
    padding: 0 24px 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.98);
  }

  .service-card__image {
    height: 156px;
    object-fit: contain;
    padding: 12px;
  }

  .visit-section {
    background: #fff;
  }

  .visit-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    gap: 64px;
    align-items: center;
  }

  .visit-facts {
    margin-top: 28px;
    display: grid;
    gap: 12px;
  }

  .visit-actions {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .visit-actions .btn {
    gap: 8px;
  }

  .visit-actions .btn--ghost {
    background: #f1f6fb;
  }

  .visit-fact {
    padding: 16px 18px;
    border: 1px solid #dfe8f2;
    border-radius: 4px;
    background: #f8fbff;
  }

  .visit-fact span,
  .visit-fact strong {
    display: block;
  }

  .visit-fact span,
  .visit-hours__heading > div > span {
    color: #0000e8;
    font-size: 0.74rem;
    font-weight: 860;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .visit-fact strong {
    margin-top: 4px;
    color: var(--color-primary-dark);
    line-height: 1.35;
  }

  .visit-hours {
    padding: 20px;
    border: 1px solid #cddff0;
    border-radius: 12px;
    background: linear-gradient(145deg, #f8fbff 0%, #eef6ff 100%);
  }

  .visit-hours__heading {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .visit-hours__icon {
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    display: grid;
    place-items: center;
    color: #0000e8;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 8px 22px rgba(0, 31, 69, 0.1);
  }

  .visit-hours__heading strong {
    display: block;
    margin-top: 2px;
    color: var(--color-primary-dark);
    font-size: 1rem;
  }

  .visit-hours__list {
    margin: 18px 0 0;
  }

  .visit-hours__list > div {
    padding: 11px 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 18px;
    align-items: start;
    border-top: 1px solid rgba(0, 59, 122, 0.12);
  }

  .visit-hours__list dt,
  .visit-hours__list dd {
    margin: 0;
    color: var(--color-primary-dark);
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .visit-hours__list dt {
    font-weight: 720;
  }

  .visit-hours__list dd {
    text-align: right;
  }

  .visit-hours__list dd span {
    display: block;
  }

  .visit-hours__list dd strong {
    color: #5b6b7e;
  }

  .visit-hours__note {
    margin: 5px 0 0;
    padding: 10px 12px;
    color: #624900;
    border-left: 3px solid #f0b92f;
    border-radius: 0 6px 6px 0;
    background: rgba(255, 244, 207, 0.72);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .visit-map {
    min-height: 440px;
    overflow: hidden;
    border: 1px solid #dfe8f2;
    border-radius: 4px;
    box-shadow: 0 22px 70px rgba(0, 31, 69, 0.12);
  }

  .visit-map iframe {
    width: 100%;
    height: 100%;
    min-height: 440px;
    display: block;
    border: 0;
  }

  @media (min-width: 1081px) {
    .visit-map,
    .visit-map iframe {
      min-height: 620px;
    }

    .anniversary-card {
      width: min(1460px, calc(100% - 64px));
      max-width: none;
    }

    .rent-teaser__card {
      width: min(1460px, calc(100% - 64px));
      max-width: none;
      min-height: 620px;
      padding: 72px clamp(72px, 6vw, 104px);
      grid-template-columns: minmax(0, 1.02fr) minmax(440px, 0.88fr);
      gap: clamp(72px, 7vw, 118px);
    }

    .rent-teaser__visual {
      min-height: clamp(430px, 32vw, 500px);
    }

    .rent-teaser__visual::before {
      width: min(100%, 480px);
      box-shadow: inset 0 0 0 36px rgba(255, 255, 255, 0.025);
    }

    .rent-teaser__phone {
      width: min(82%, 370px);
      border-radius: 32px;
    }

    .rent-teaser__phone img {
      padding: 24px;
    }

    .rent-teaser__price {
      top: 10px;
      left: 8px;
      min-width: 174px;
      padding: 19px 21px;
      border-radius: 16px;
    }

    .rent-teaser__price span,
    .rent-teaser__price small {
      font-size: 0.8rem;
    }

    .rent-teaser__price strong {
      font-size: 2.05rem;
    }

    .rent-teaser__device-label {
      right: 6px;
      bottom: 18px;
      min-height: 48px;
      padding-inline: 18px;
      font-size: 0.96rem;
    }
  }

  @media (max-width: 1080px) {
    .category-grid,
    .service-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .catalog-layout {
      grid-template-columns: 1fr;
    }

    .catalog-sidebar {
      position: static;
      display: flex;
      overflow-x: auto;
      border-right: 0;
      scrollbar-width: none;
      padding-bottom: 4px;
    }

    .catalog-sidebar::-webkit-scrollbar {
      display: none;
    }

    .catalog-sidebar a {
      flex: 0 0 auto;
      border: 1px solid #dfe8f2;
      border-radius: 4px;
      margin-right: 10px;
    }
  }

  @media (max-width: 860px) {
    .anniversary-card {
      grid-template-columns: 1fr;
    }

    .anniversary-portrait {
      min-height: 0;
      aspect-ratio: 5 / 4;
    }

    .business-layout,
    .social-layout,
    .visit-layout {
      grid-template-columns: 1fr;
    }

    .business-layout,
    .social-layout,
    .visit-layout {
      gap: 40px;
    }

    .rent-teaser__card {
      grid-template-columns: 1fr;
    }

    .rent-teaser__copy {
      max-width: 720px;
    }

    .rent-teaser__visual {
      width: min(100%, 520px);
      margin-inline: auto;
    }
  }

  @media (max-width: 640px) {
    .home-hero {
      min-height: auto;
    }

    .home-hero__inner {
      padding: 64px 0 46px;
    }

    .home-hero h1 {
      font-size: clamp(2.35rem, 15vw, 3.45rem);
      line-height: 0.96;
    }

    .home-hero p,
    .section-head p,
    .business-copy p,
    .visit-copy p {
      font-size: 1rem;
      line-height: 1.68;
    }

    .anniversary-section {
      padding: 54px 0;
    }

    .rent-teaser {
      padding: 44px 0;
    }

    .rent-teaser__card {
      min-height: 0;
      padding: 34px 22px 30px;
      gap: 28px;
      border-radius: 18px;
    }

    .rent-teaser h2 {
      font-size: clamp(2.15rem, 11.5vw, 3.2rem);
    }

    .rent-teaser__copy > p {
      font-size: 1rem;
      line-height: 1.65;
    }

    .rent-teaser__benefits {
      display: grid;
    }

    .rent-teaser__cta {
      width: 100%;
      justify-content: space-between;
    }

    .rent-teaser__visual {
      min-height: 310px;
    }

    .rent-teaser__visual::before {
      width: 290px;
    }

    .rent-teaser__phone {
      width: 210px;
    }

    .rent-teaser__price {
      top: 2px;
      left: -2px;
      min-width: 130px;
      padding: 13px 14px;
    }

    .rent-teaser__price strong {
      font-size: 1.45rem;
    }

    .rent-teaser__device-label {
      right: -4px;
      bottom: 4px;
      font-size: 0.78rem;
    }

    .anniversary-card {
      border-radius: 18px;
    }

    .anniversary-portrait {
      aspect-ratio: 1 / 1;
    }

    .anniversary-seal {
      bottom: 14px;
      left: 16px;
      width: 104px;
      height: 104px;
      border-width: 4px;
    }

    .anniversary-seal strong {
      font-size: 3rem;
    }

    .anniversary-seal span {
      margin-top: 6px;
      font-size: 0.61rem;
    }

    .anniversary-portrait figcaption {
      right: 18px;
      bottom: 16px;
      left: 132px;
      font-size: 0.86rem;
    }

    .anniversary-copy {
      padding: 30px 22px 34px;
    }

    .anniversary-copy h2 {
      font-size: clamp(2.05rem, 11vw, 3rem);
    }

    .anniversary-lead {
      font-size: 1rem;
      line-height: 1.65;
    }

    .anniversary-family div {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }

    .anniversary-family span {
      text-align: left;
    }

    .category-grid,
    .catalog-sidebar {
      display: none;
    }

    .mobile-category-list {
      display: grid;
      gap: 10px;
    }

    .mobile-category-card {
      overflow: hidden;
      border: 1px solid #dfe8f2;
      border-radius: 4px;
      background: #fff;
      box-shadow: 0 10px 28px rgba(0, 31, 69, 0.06);
    }

    .mobile-category-card summary {
      min-height: 58px;
      padding: 14px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      color: #001f45;
      cursor: pointer;
      list-style: none;

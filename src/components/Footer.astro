---
import { openingHours, site } from '../data/site';
import { digitalServices, productCategories } from '../data/catalog';
import { getImageDimensions } from '../data/image-dimensions';
import { ArrowUp, ExternalLink, Mail, MapPin, Phone } from '@lucide/astro';

const footerProducts = productCategories.slice(0, 7);
const footerServices = digitalServices.slice(0, 5);
---

<footer class="footer">
  <div class="footer-topline"></div>

  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="footer-logo-row">
        <img src="/images/logo-buffetti.png" alt="Logo Buffetti Cucchi" width="221" height="113" />
        <div>
          <strong>Buffetti Cucchi</strong>
          <span>Cartoleria, ufficio e servizi a Cesena</span>
        </div>
      </div>

      <span class="footer-vat">{site.vat}</span>

      <p>
        Un negozio Buffetti locale: prodotti per scuola e ufficio, servizi digitali,
        stampa, timbri, spedizioni, pelletteria e supporto diretto al banco.
      </p>

      <div class="footer-social">
        <a href={site.facebook} target="_blank" rel="noopener noreferrer">
          <img src="/images/facebook.svg" alt="" {...getImageDimensions('/images/facebook.svg')} />
          Facebook
        </a>
        <a href={site.instagram} target="_blank" rel="noopener noreferrer">
          <img src="/images/instagram.svg" alt="" {...getImageDimensions('/images/instagram.svg')} />
          Instagram
        </a>
      </div>
    </div>

    <div class="footer-col">
      <h2>Catalogo</h2>
      <nav aria-label="Categorie prodotto footer">
        {footerProducts.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
    </div>

    <div class="footer-col">
      <h2>Servizi</h2>
      <nav aria-label="Servizi footer">
        {footerServices.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
        <a href="/servizi.html">Tutti i servizi</a>
      </nav>
    </div>

    <div class="footer-contact-card">
      <span>Contatto rapido</span>
      <h2>Chiedi prima di passare</h2>
      <a href={site.phoneHref}>
        <Phone size={18} stroke-width={2.2} />
        {site.phone}
      </a>
      <a href={site.emailHref}>
        <Mail size={18} stroke-width={2.2} />
        {site.email}
      </a>
      <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
        <MapPin size={18} stroke-width={2.2} />
        Viale Matteotti, 593
      </a>
    </div>
  </div>

  <div class="container footer-hours">
    <div>
      <span>Orari</span>
      <strong>{openingHours.weekdays.shortLabel} {openingHours.weekdays.footerText}</strong>
    </div>
    <div>
      <span>{openingHours.saturday.label}</span>
      <strong>{openingHours.saturday.footerStatus}</strong>
    </div>
    <div>
      <span>{openingHours.sunday.label}</span>
      <strong>{openingHours.sunday.status}</strong>
    </div>
    <div>
      <span>Ragione sociale</span>
      <strong>{site.fullName}</strong>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© 2026 Buffetti Cucchi s.a.s. Tutti i diritti riservati.</span>

    <div class="footer-legal-links">
      <a href="/privacy-policy.html">Privacy e Cookie Policy</a>
    </div>

    <a
      class="footer-credit"
      href="https://avely.me/tmsbgn"
      target="_blank"
      rel="noopener noreferrer"
      title="Visita il mio portfolio"
      aria-label="Visita il mio portfolio"
    >
      <img class="footer-credit-avatar" src="/images/pfp-96.webp" alt="" width="44" height="44" loading="lazy" />

      <span class="footer-credit-content">
        <span class="footer-credit-kicker">Sito sviluppato da</span>
        <strong>Bagnolini Tommaso</strong>
      </span>

      <span class="footer-credit-arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path d="M7 17L17 7" />
          <path d="M9 7H17V15" />
        </svg>
      </span>
    </a>
  </div>
  <span class="footer-end-sentinel" aria-hidden="true"></span>
</footer>

<a class="footer-back-top" href="#top" data-back-to-top hidden>
  Torna su
  <ArrowUp size={17} stroke-width={2.5} aria-hidden="true" />
</a>

<script>
  const backToTop = document.querySelector('[data-back-to-top]');
  const footerEnd = document.querySelector('.footer-end-sentinel');

  if (backToTop instanceof HTMLElement && footerEnd) {
    const observer = new IntersectionObserver(([entry]) => {
      backToTop.hidden = !entry.isIntersecting;
    }, { threshold: 0.1 });

    observer.observe(footerEnd);
  }
</script>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    padding: 0 0 34px;
    color: rgba(255, 255, 255, 0.78);
    background:
      radial-gradient(circle at 10% 8%, rgba(0, 166, 232, 0.2), transparent 28%),
      linear-gradient(135deg, #020716, #06142d 54%, #0000e8);
  }

  .footer::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.16;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 26px 26px;
    pointer-events: none;
  }

  .footer-topline {
    position: relative;
    z-index: 1;
    height: 8px;
    background: #0000e8;
  }

  .footer-inner,
  .footer-hours,
  .footer-bottom {
    position: relative;
    z-index: 1;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.35fr 0.78fr 0.78fr 1fr;
    gap: 48px;
    padding: 76px 0 42px;
  }

  .footer-logo-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .footer-logo-row img {
    width: 92px;
    height: auto;
    filter: drop-shadow(0 14px 22px rgba(0, 0, 0, 0.35));
  }

  .footer-logo-row div {
    display: grid;
    gap: 2px;
  }

  .footer-logo-row strong,
  .footer-col h2 {
    color: #fff;
    font-size: 1.02rem;
    font-weight: 840;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .footer-logo-row span,
  .footer-contact-card > span,
  .footer-hours span {
    color: #9fe9ff;
    font-size: 0.76rem;
    font-weight: 840;
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }

  .footer-brand p {
    max-width: 440px;
    margin: 18px 0 24px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.02rem;
    line-height: 1.72;
  }

  .footer-vat {
    margin-top: 14px;
    display: block;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.8rem;
    font-weight: 760;
    letter-spacing: 0.04em;
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .footer-social a {
    min-height: 42px;
    padding: 0 13px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #001f45;
    background: #fff;
    border-radius: 4px;
    font-weight: 840;
  }

  .footer-social img {
    width: 18px;
    height: 18px;
  }

  .footer-col h2 {
    margin: 0 0 22px;
  }

  .footer-col nav {
    display: grid;
    gap: 12px;
  }

  .footer-col a {
    width: fit-content;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.96rem;
    font-weight: 760;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .footer-col a:hover {
    color: #fff;
    transform: translateX(4px);
  }

  .footer-contact-card {
    padding: 26px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.22);
  }

  .footer-contact-card h2 {
    margin: 16px 0 22px;
    color: #fff;
    font-size: 1.7rem;
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .footer-credit {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    width: fit-content;
    max-width: 320px;
    padding: 12px 14px;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 18px;
    background: rgba(239, 246, 255, 0.94);
    color: #082f49;
    text-decoration: none;
    box-shadow: 0 14px 34px rgba(255, 255, 255, 0.08);
    transition:
      transform 0.22s ease,
      border-color 0.22s ease,
      box-shadow 0.22s ease,
      background 0.22s ease;
  }

  .footer-credit:hover {
    transform: translateY(-3px);
    border-color: rgba(14, 165, 233, 0.34);
    background: #ffffff;
    color: #082f49;
    text-decoration: none;
    box-shadow: 0 18px 42px rgba(255, 255, 255, 0.14);
  }

  .footer-credit-avatar {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    border-radius: 14px;
    background: linear-gradient(135deg, #0284c7, #38bdf8);
    color: #ffffff;
    font-size: 0.76rem;
    font-weight: 900;
    box-shadow: 0 10px 20px rgba(14, 165, 233, 0.22);
  }

  .footer-credit-content {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .footer-credit .footer-credit-kicker {
    color: #31546c;
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .footer-credit-content strong {
    color: #082f49;
    font-size: 0.92rem;
    font-weight: 900;
    line-height: 1.08;
    white-space: nowrap;
  }

  .footer-credit-content small {
    color: #0284c7;
    font-size: 0.78rem;
    font-weight: 850;
  }

  .footer-credit .footer-credit-arrow {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-left: 2px;
    flex: 0 0 32px;
    border-radius: 50%;
    background: #0369a1;
    color: #ffffff;
    transition: transform 0.22s ease, background 0.22s ease, color 0.22s ease;
  }

  .footer-credit-arrow svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .footer-credit:hover .footer-credit-arrow {
    transform: translate(2px, -2px);
    background: #0284c7;
    color: #ffffff;
  }

  .footer-credit:focus-visible {
    outline: 3px solid #7dd3fc;
    outline-offset: 4px;
  }

  .footer-contact-card a {
    min-height: 42px;
    display: flex;
    align-items: center;
    gap: 10px;
    color: rgba(255, 255, 255, 0.82);
    font-weight: 760;
  }

  .footer-contact-card svg {
    color: #9fe9ff;
  }

  .footer-hours {
    display: grid;
    grid-template-columns: 1fr 0.6fr 0.6fr 1.2fr;
    gap: 1px;
    overflow: hidden;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.12);
  }

  .footer-hours div {
    padding: 18px;
    background: rgba(255, 255, 255, 0.07);
  }

  .footer-hours strong {
    display: block;
    margin-top: 6px;
    color: #fff;
    line-height: 1.3;
  }

  .footer-bottom {
    margin-top: 34px;
    padding-top: 28px;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .footer-bottom span,
  .footer-bottom a {
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.92rem;
  }

  .footer-bottom a {
    font-weight: 760;
  }

  .footer-bottom a:hover {
    color: #fff;
  }

  .footer-legal-links {
    margin-left: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 10px 16px;
  }

  .footer-back-top {
    position: fixed;
    right: max(18px, env(safe-area-inset-right));
    bottom: max(18px, env(safe-area-inset-bottom));
    z-index: 30;
    min-height: 46px;
    padding: 0 16px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    background: rgba(0, 31, 69, 0.9);
    box-shadow: 0 14px 36px rgba(0, 18, 44, 0.28);
    backdrop-filter: blur(12px);
    font-size: 0.88rem;
    font-weight: 820;
    transition: transform 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
  }

  .footer-back-top[hidden] {
    display: none;
  }

  .footer-back-top:hover {
    color: #fff;
    background: #003b7a;
    box-shadow: 0 18px 42px rgba(0, 18, 44, 0.36);
    transform: translateY(-2px);
  }

  .footer-end-sentinel {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 1px;
    height: 80px;
    pointer-events: none;
  }

  @media (max-width: 1050px) {
    .footer-inner,
    .footer-hours {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 680px) {
    .footer-inner,
    .footer-hours {
      grid-template-columns: 1fr;
    }

    .footer-inner {
      padding-top: 58px;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .footer-legal-links {
      width: 100%;
      margin-left: 0;
      justify-content: center;
    }

    .footer-credit {
      margin-inline: auto;
    }

    .footer-back-top {
      right: auto;
      left: 50%;
      top: 178px;
      bottom: auto;
      transform: translateX(-50%);
    }

    .footer-back-top:hover {
      transform: translateX(-50%) translateY(-2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-back-top {
      transition: none;
    }
  }
</style>
